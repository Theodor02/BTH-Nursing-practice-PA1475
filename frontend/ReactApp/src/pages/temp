    function eval_formula(formula: string, vals: Record<string, string|number>): string {
        try {
            let expr = formula;
            Object.entries(vals).forEach(([n,val]) => { expr = expr.replaceAll(n, String(val)); });
            return String(parseFloat(eval(expr).toFixed(10)));
        } catch { return "?"; }
    }

    function render_preview(text: string, vals: Record<string, string|number>): React.ReactNode[] {
        const out: React.ReactNode[] = [];
        const rx = /\{(\w+)\}/g;
        let last = 0, i = 0, m;
        while ((m = rx.exec(text)) !== null) {
            if (m.index > last) out.push(<span key={`t${i++}`}>{text.slice(last, m.index)}</span>);
            out.push(<strong key={`v${i++}`} style={{background:"rgba(0,0,0,0.1)",padding:"0.1rem 0.5rem",borderRadius:"6px"}}>{vals[m[1]] ?? `{${m[1]}}`}</strong>);
            last = rx.lastIndex;
        }
        if (last < text.length) out.push(<span key={`t${i++}`}>{text.slice(last)}</span>);
        return out;
    }

