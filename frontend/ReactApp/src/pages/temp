    function updateVariablesAndSample(updater: (prev: Variable[]) => Variable[]) {
        const newVars = updater(variables);
        setVariables(newVars);
        // Manually update sampled values with the new variables
        const result: Record<string, string|number> = {};
        newVars.forEach(v => {
            if (v.type === 0) {
                const min = v.min ?? 0, max = v.max ?? 100, step = v.step ?? 1;
                const dec = v.decimals ?? 0;
                const val = min + Math.floor(Math.random() * (Math.floor((max-min)/step)+1)) * step;
                result[v.name] = parseFloat(val.toFixed(dec));
            } else if (v.type === 1) {
                const arr = v.arr ?? []; result[v.name] = arr[Math.floor(Math.random()*arr.length)] ?? "";
            } else if (v.type === 3) {
                const std = ["Anna","Erik","Maria","Johan","Lisa"];
                const pool = typeof v.names === 'string' ? std : (v.names ?? std);
                result[v.name] = pool[Math.floor(Math.random()*pool.length)];
            }
        });
        newVars.forEach(v => {
            if (v.type === 2 && v.formula) {
                try {
                    let expr = v.formula;
                    Object.entries(result).forEach(([n,val]) => { expr = expr.replaceAll(n, String(val)); });
                    result[v.name] = parseFloat(eval(expr).toFixed(v.decimals ?? 0));
                } catch { result[v.name] = "?"; }
            }
        });
        setSampledValues(result);
    }

