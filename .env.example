# Copy this file to .env and fill in the real values.

# Database (required for production)
POSTGRES_PASSWORD=change-me-use-a-strong-random-password

# Flask session secret — generate with: openssl rand -hex 32
FLASK_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

AZURE_TENANT_ID=your-tenant-id
AZURE_FRONTEND_CLIENT_ID=your-spa-application-client-id
AZURE_API_CLIENT_ID=your-backend-api-application-client-id
AZURE_API_REQUIRED_SCOPE=access_as_user
ALLOWED_EMAIL_DOMAINS=student.bth.se,bth.se
SUPER_ADMIN_EMAILS=admin1@example.com,admin2@example.com

VITE_AZURE_TENANT_ID=your-tenant-id
VITE_AZURE_CLIENT_ID=your-spa-application-client-id
VITE_AZURE_API_SCOPE=api://your-backend-api-application-client-id/access_as_user
